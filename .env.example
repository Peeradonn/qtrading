# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Roostoo competition account (the risk-on twin uses the same names with the _RISKON suffix)
ROOSTOO_API_KEY=your-api-key
ROOSTOO_SECRET_KEY=your-secret-key
ROOSTOO_BASE_URL=https://mock-api.roostoo.com

# Operator alerts — a Discord channel webhook (Channel settings -> Integrations -> Webhooks -> Copy URL)
ALERT_WEBHOOK_URL=

# Dead-man's switch — a healthchecks.io ping URL; the bot pings it after every cycle (and <url>/fail on errors)
HEARTBEAT_URL=
# One check per bot is better: the name is the bot's, upper-cased, with dashes as underscores. A shared check stays
# green while any one bot pings it, so a dead bot goes unnoticed. These override HEARTBEAT_URL for that bot.
HEARTBEAT_URL_EQVT3=
HEARTBEAT_URL_PAPER_CORE=
HEARTBEAT_URL_PAPER_EQVT3=
HEARTBEAT_URL_PAPER_LS25=

# Telegram is used only if ALERT_WEBHOOK_URL is empty
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local mock exchange (scripts/mock_roostoo.py) — fixed non-secret test values
ROOSTOO_API_KEY_MOCK=MOCKKEY
ROOSTOO_SECRET_KEY_MOCK=MOCKSECRET
